from typing import Any, overload, Sequence

from jax._array import Array
from shape_extensions import broadcast, IntTuple

type _Shape = IntTuple

# Every activation JAX exposes here is elementwise, so the shape is preserved.
# `softmax` and `log_softmax` normalize along `axis` but do not reduce it away.
# `elu` and `leaky_relu` take their parameter as an array as well as a scalar,
# and an array parameter broadcasts against the input rather than preserving
# its shape.
def relu[Shape: _Shape](x: Array[Shape]) -> Array[Shape]: ...
def relu6[Shape: _Shape](x: Array[Shape]) -> Array[Shape]: ...
def sigmoid[Shape: _Shape](x: Array[Shape]) -> Array[Shape]: ...
def softplus[Shape: _Shape](x: Array[Shape]) -> Array[Shape]: ...
def soft_sign[Shape: _Shape](x: Array[Shape]) -> Array[Shape]: ...
def silu[Shape: _Shape](x: Array[Shape]) -> Array[Shape]: ...
def swish[Shape: _Shape](x: Array[Shape]) -> Array[Shape]: ...
@overload
def elu[Shape: _Shape](x: Array[Shape], alpha: float = ...) -> Array[Shape]: ...
@overload
def elu[Shape: _Shape, ParamShape: _Shape](
    x: Array[Shape], alpha: Array[ParamShape] = ...
) -> Array[broadcast(Shape, ParamShape)]: ...
@overload
def leaky_relu[Shape: _Shape](
    x: Array[Shape], negative_slope: float = ...
) -> Array[Shape]: ...
@overload
def leaky_relu[Shape: _Shape, ParamShape: _Shape](
    x: Array[Shape], negative_slope: Array[ParamShape] = ...
) -> Array[broadcast(Shape, ParamShape)]: ...
def gelu[Shape: _Shape](x: Array[Shape], approximate: bool = ...) -> Array[Shape]: ...
def hard_tanh[Shape: _Shape](x: Array[Shape]) -> Array[Shape]: ...
def softmax[Shape: _Shape](
    x: Array[Shape], axis: Sequence[int] | int | None = ..., where: Any = ...
) -> Array[Shape]: ...
def log_softmax[Shape: _Shape](
    x: Array[Shape], axis: Sequence[int] | int | None = ..., where: Any = ...
) -> Array[Shape]: ...
